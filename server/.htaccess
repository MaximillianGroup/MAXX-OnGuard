# Domain Redirects

<IfModule mod_rewrite.c>
    # Redirect only the front-end (exclude wp-admin and wp-login.php)
    RewriteEngine On

    # Mixed Content Prevention (Force HTTPS)
    #RewriteCond %{HTTPS} off
    #RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

</IfModule>
######################################################################
# WordPress MultiSite
######################################################################

# BEGIN WordPress Multisite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteBase /
    RewriteRule ^index\.php$ - [L]
    
    # add a trailing slash to /wp-admin
    RewriteRule ^wp-admin$ wp-admin/ [R=301,L]
    
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^(wp-(content|admin|includes).*) $1 [L]
    RewriteRule ^(.*\.php)$ $1 [L]
    RewriteRule . index.php [L]

</IfModule>
# END WordPress Multisite

######################################################################
# Security Rewrites
######################################################################
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
   
    # Block Malicious Image Uploads with Embedded PHP
    RewriteCond %{HTTP:Content-Disposition} \.php [NC]
    RewriteCond %{HTTP:Content-Type} ^image/ [NC]
    RewriteRule .* - [F,L]

</IfModule>

######################################################################
# Image Rewrites & Headers
######################################################################

# Ensure manual WebP/AVIF delivery
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Check for AVIF browser support, but ONLY for JPG, GIF, SVG (no PNG)
  RewriteCond %{HTTP:Accept} image/avif
  RewriteCond %{DOCUMENT_ROOT}/$1.avif -f
  RewriteRule (.+)\.(jpe?g|gif|svg)$ $1.avif [T=image/avif,E=image_optimized:1,L]

  # Check for WebP browser support, but ONLY for JPG, GIF, SVG (no PNG)
  RewriteCond %{HTTP:Accept} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule (.+)\.(jpe?g|gif|svg)$ $1.webp [T=image/webp,E=image_optimized:1,L]

  # Fallback to original image
  RewriteCond %{ENV:image_optimized} !1
  RewriteRule (.+)\.(jpe?g|png|gif|svg)$ $1.$2 [L]
  
</IfModule>

######################################################################
# Headers
######################################################################
# Ensure the Vary Header is set for proper caching
<FilesMatch "\.(jpe?g|svg|webp|gif|avif)$">
    <IfModule mod_headers.c>
      Header append Vary Accept env=image_optimized
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set Content-Language "en-US"

    # remove server information for security protection
    Header unset X-Powered-By
    Header unset Server
    Header set X-Backend "Apache"
    # force UTF-8
     
    # Force the latest IE version, in various cases when it may fall back to IE7 mode
    # futher details: github.com/rails/rails/commit/123eb25#commitcomment-118920
    # Use ChromeFrame if it's installed for a better experience for the poor IE folks
    Header set X-UA-Compatible "IE=Edge,chrome=1"

    # mod_headers cannnot match by content-type, but we don't want to send this header on *everything*...
    <FilesMatch "\.(js|css|gif|png|jpe?g|pdf|xml|oga|ogg|m4a|ogv|mp4|m4v|webm|svg|svgz|eot|ttf|otf|woff|ico|webp|appcache|manifest|htc|crx|oex|xpi|safariextz|vcf)$" >
        Header unset X-UA-Compatible
    </FilesMatch>

    # OUTDATED BUT SOMETIMES USED
    #Header set P3P "policyref="/w3c/p3p.xml", CP="NOI DSP COR NID CUR ADM DEV OUR BUS""
    # OR THIS, SIMPLER
    # Header set P3P "policyref="/w3c/p3p.xml""

    ######################################################################
    #   SECURITY HEADERS - CSP, NEL & Reporting
    #   Content Security policy and Feature Policy
    ######################################################################

    # 1. Modern Reporting API Header (Report-To)
    #    Defines the endpoint where all browser reports (CSP, NEL, etc.) will be sent.
    Header always set Report-To "{\"group\":\"default\",\"max_age\":31536000,\"endpoints\":[{\"url\":\"https://YOUR-DOMAIN.report-uri.com/a/d/g\"}],\"include_subdomains\":true}"
    
    # 2. Network Error Logging (NEL)
    #    Instructs the browser to send reports about network failures to the 'default' group defined above.
    Header always set NEL "{\"report_to\":\"default\",\"max_age\":31536000,\"include_subdomains\":true}"
    
    # 3. Content Security Policy (in Report-Only mode for safe testing)
    #    This is the complete, merged policy in the required single-line format.
    #Header always set Content-Security-Policy-Report-Only "default-src 'self' https://*.YOUR-DOMAIN.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.YOUR-DOMAIN.com https://hb.wpmucdn.com https://stats.wpmucdn.com https://analytics.wpmucdn.com https://cdn.onesignal.com https://onesignal.com https://js-agent.newrelic.com https://www.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' blob: https://*.YOUR-DOMAIN.com https://hb.wpmucdn.com https://cdnjs.cloudflare.com https://fonts.googleapis.com https://onesignal.com; font-src 'self' data: https://*.YOUR-DOMAIN.com https://fonts.gstatic.com https://static2.sharepointonline.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.YOUR-DOMAIN.com https://*.smushcdn.com https://secure.gravatar.com https://www.googletagmanager.com; connect-src 'self' https://*.YOUR-DOMAIN.com https://bam.nr-data.net https://stats3.wpmudev.com https://analytics3.wpmudev.com https://l.clarity.ms https://challenges.cloudflare.com https://www.google-analytics.com https://static.cloudflareinsights.com; media-src 'self' blob: https://*.YOUR-DOMAIN.com; frame-src 'self' blob: https://*.YOUR-DOMAIN.com https://*.YOUR-DOMAIN.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://challenges.cloudflare.com; form-action 'self' https://*.YOUR-DOMAIN.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; report-uri https://your-reporting-endpoint.com/report;"

    # Site-wide baseline (deny-by-default, with minimal allows)
    # --- Baseline (site-wide) ---
    # --- Site-wide baseline (Deny-by-default) ---
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(self), clipboard-read=(self), clipboard-write=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

    # Exception for the audio submission page to allow microphone access.
    # We check if the request is for your specific page URL.
    SetEnvIfExpr "%{REQUEST_URI} =~ m#^/star-submit-audio/?$#" StarmusMicAllowed=1
    
    # If the environment variable is set, send a DIFFERENT, more permissive policy.
    # This policy is identical to the baseline, but changes microphone=() to microphone=(self).
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(self), clipboard-read=(self), clipboard-write=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" env=StarmusMicAllowed
    
    # --- Exceptions by path (match REQUEST_URI) ---
    # Microphone: /record-submission
    #SetEnvIfExpr "%{REQUEST_URI} =~ m#^/record-submission/?$#" mic_ok=1
    #Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), clipboard-read=(self), clipboard-write=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" env=mic_ok

    # Geolocation: /profile
    #SetEnvIfExpr "%{REQUEST_URI} =~ m#^/profile/?$#" geo_ok=1
    #Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), clipboard-read=(self), clipboard-write=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" env=geo_ok

    #WooCommerce payment pages
    #SetEnvIfExpr "%{REQUEST_URI} =~ m#^/(checkout|cart|my-account/add-payment-method)/##" pay_ok=1
    #Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), clipboard-read=(self), clipboard-write=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(self), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" env=pay_ok

</IfModule>

######################################################################
# CORS Headers
######################################################################

<IfModule mod_setenvif.c>
    # Whitelist front-end and overlay domains for CORS
    SetEnvIf Origin "https?://([a-z0-9-]+\.)*YOUR-DOMAIN\.com$" IS_CORS=$0

</IfModule>

## Pre-check Handling Options for the CORS
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Handle CORS Preflight Requests (OPTIONS method) only for non-existing files/directories
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ - [R=204,L]

</IfModule>

<IfModule mod_headers.c>
    # Apply dynamic Access-Control-Allow-Origin
    Header always set Access-Control-Allow-Origin "%{IS_CORS}e" env=IS_CORS
    Header always set Access-Control-Allow-Credentials "true" env=IS_CORS

    # Allow required methods & headers for REST
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE" env=IS_CORS
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-WP-Nonce, X-HTTP-Method-Override, DNT, Keep-Alive, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Upgrade-Insecure-Requests" env=IS_CORS
    Header always set Access-Control-Max-Age "1728000" env=IS_CORS

    # Extra protections
    Header always set X-Content-Type-Options "nosniff" env=IS_CORS
    Header always set X-Frame-Options "SAMEORIGIN" env=IS_CORS
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header set Vary "Origin" env=IS_CORS

    # Keep admin locked down
    <If "%{REQUEST_URI} =~ m#^/wp-admin/#">
        Header always unset Access-Control-Allow-Origin
    </If>

    # Apply CORS for static assets
    <FilesMatch "\.(css|font.css|js|bmp|cur|gif|ico|jpe?g|a?png|svgz?|webp|heic|heif|avif|eot|otf|ttf|ttc|woff|woff2)$">
        Header always set Access-Control-Allow-Origin "%{IS_CORS}e" env=IS_CORS
        Header set Vary "Origin" env=IS_CORS
    </FilesMatch>

    # Cross-Origin policies for browser isolation
    Header always set Cross-Origin-Opener-Policy "cross-origin-allow-popups" env=IS_CORS
    Header always set Cross-Origin-Resource-Policy "cross-origin" env=IS_CORS
    Header always set Cross-Origin-Embedder-Policy "require-corp" env=IS_CORS

</IfModule>

######################################################################
#  Prevent information disclosure
######################################################################

<FilesMatch "\.(png|jpe?g|gif|webp|svg|webm|weba|ogg|wav|mp3|icon)$">
  Require all granted
</FilesMatch>

# Block specific file types from direct access
<FilesMatch "\.(env|ini|pl|py|jsp|asp|cgi)$">
    Require all denied
</FilesMatch>

# Block wp-config.php, .htaccess, .htpasswd, and debug.log
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|debug\.log)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|exe|sh|bak|old|inc|pot|po|mo|log|sql|htaccess|htpasswd|phps|fla|psd|ini|conf|pool|jail|env|d|conf)$">
    Require all denied
</FilesMatch>

<Files robots.txt>
    Require all granted
</Files>

<Files security.txt>
    Require all granted
</Files>

<Files ads.txt>
    Require all granted
</Files>

<Files sitemap.xml>
    Require all granted
</Files>

######################################################################
# CACHING
######################################################################

# Browser Cache methods
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault A0

    # Images
    <FilesMatch "\.(gif|png|apng|jpe?g|webp|avif|svgz?|ico|bmp)$">
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/apng "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/avif "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType image/svgz "access plus 1 year"
        ExpiresByType image/x-icon "access plus 1 year"
        ExpiresByType image/bmp "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"

    </FilesMatch>

    # Fonts
    <FilesMatch "\.(ttf|otf|woff2?|eot)$">
        ExpiresByType font/ttf "access plus 1 year"
        ExpiresByType font/otf "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType application/font-woff "access plus 1 year"
        ExpiresByType application/font-woff2 "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"

    </FilesMatch>

    # Videos & Audio
    <FilesMatch "\.(mp4|mp3|ogg|wav|flac|m4a|webm|weba)$">
        ExpiresByType video/mp4 "access plus 1 day"
        ExpiresByType audio/mp3 "access plus 1 day"
        ExpiresByType audio/ogg "access plus 1 day"
        ExpiresByType audio/wav "access plus 1 day"
        ExpiresByType audio/flac "access plus 1 day"
        ExpiresByType audio/m4a "access plus 1 day"
        ExpiresByType video/webm "access plus 1 year"
        ExpiresByType audio/weba "access plus 1 year"
        Header set Cache-Control "public, max-age=86400, must-revalidate, stale-if-error=86400"

    </FilesMatch>

    # CSS, JS
    <FilesMatch "\.(css|js)$">
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType text/javascript "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType application/x-javascript "access plus 1 year"
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # feeds
    <FilesMatch "\.(atom|rss)$">
        ExpiresByType application/atom+xml "access plus 1 hour"
        ExpiresByType application/rss+xml "access plus 1 hour"
        Header set Cache-Control "public, max-age=3600, must-revalidate, stale-if-error=3600"
    </FilesMatch>

    # GZIP, BROTLI
    <FilesMatch "\.(br|gz)$">
      ExpiresByType application/x-brotli "access plus 1 hour"
      ExpiresByType application/x-gzip "access plus 1 hour"
      Header set Cache-Control "max-age=3600, public"

    </FilesMatch>

    # files
    <FilesMatch "\.pdf$">
        ExpiresByType application/pdf "access plus 1 year"
        Header set Cache-Control "max-age=31536000, public"

    </FilesMatch>

   #JSON, TEXT
   <FilesMatch "\.(json|txt)$">
        ExpiresByType application/json "access plus 1 year"
        ExpiresByType text/plain "access plus 1 year"
        Header set Cache-Control "max-age=31536000"

    </FilesMatch>

    # Static Configuration Files (manifest.json, browserconfig.xml)
    <FilesMatch "\.(json)$">
      ExpiresActive On
      ExpiresByType application/json "access plus 1 year"

      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=31536000, immutable, stale-if-error=86400"
      </IfModule>

    </FilesMatch>

    <FilesMatch "\.(xml)$">
      ExpiresActive On
      ExpiresByType application/xml "access plus 1 year"

      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=31536000, immutable, stale-if-error=86400"
      </IfModule>

    </FilesMatch>

   # RSS/Atom Feeds (feed, atom.xml) - Adjust filename matching if needed
    <FilesMatch "(feed|atom\.xml)$">
      ExpiresActive On
      ExpiresByType application/rss+xml "access plus 1 hour"
      ExpiresByType application/atom+xml "access plus 1 hour"

      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=3600, must-revalidate, stale-if-error=3600"
      </IfModule>

   </FilesMatch>

    # API Responses (/wp-json/*) - These should NOT be cached
    <FilesMatch "^/wp-json/.*$">
      ExpiresActive Off

      <IfModule mod_headers.c>
          Header set Cache-Control "no-store, must-revalidate, private"
          Header set Expires "0"
      </IfModule>

    </FilesMatch>

    <FilesMatch "\.(html|htm|php)$">
        ExpiresActive Off
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Expires "0"
    </FilesMatch>

</IfModule>

######################################################################
# End of File
######################################################################
