# 8G:[USER AGENT]
<IfModule mod_rewrite.c>

        RewriteCond %{HTTP_USER_AGENT} ([a-z0-9]{2000,}) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (&lt;|%0a|%0d|%27|%3c|%3e|%00|0x00|\\\x22) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (ahrefs|archiver|curl|libwww-perl|pycurl|scan) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (oppo\sa33|(c99|php|web)shell|site((.){0,2})copier) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (base64_decode|bin/bash|disconnect|eval|unserializ) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (acapbot|acoonbot|alexibot|asterias|attackbot|awario|backdor|becomebot|binlar|blackwidow|blekkobot|blex|blowfish|bullseye|bunnys|butterfly|careerbot|casper) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (checkpriv|cheesebot|cherrypick|chinaclaw|choppy|clshttp|cmsworld|copernic|copyrightcheck|cosmos|crescent|datacha|(\b)demon(\b)|diavol|discobot|dittospyder) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (dotbot|dotnetdotcom|dumbot|econtext|emailcollector|emailsiphon|emailwolf|eolasbot|eventures|extract|eyenetie|feedfinder|flaming|flashget|flicky|foobot|fuck) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (g00g1e|getright|gigabot|go-ahead-got|gozilla|grabnet|grafula|harvest|heritrix|httracks?|icarus6j|jetbot|jetcar|jikespider|kmccrew|leechftp|libweb|liebaofast) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (linkscan|linkwalker|loader|lwp-download|majestic|masscan|miner|mechanize|mj12bot|morfeus|moveoverbot|netmechanic|netspider|nicerspro|nikto|ninja|nominet|nutch) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (octopus|pagegrabber|petalbot|planetwork|postrank|proximic|purebot|queryn|queryseeker|radian6|radiation|realdownload|remoteview|rogerbot|scan|scooter|seekerspid) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (semalt|siclab|sindice|sistrix|sitebot|siteexplorer|sitesnagger|skygrid|smartdownload|snoopy|sosospider|spankbot|spbot|sqlmap|stackrambler|stripper|sucker|surftbot) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (sux0r|suzukacz|suzuran|takeout|teleport|telesoft|true_robots|turingos|turnit|vampire|vikspider|voideye|webleacher|webreaper|webstripper|webvac|webviewer|webwhacker) [NC,OR]
        RewriteCond %{HTTP_USER_AGENT} (winhttp|wwwoffle|woxbot|xaldon|xxxyy|yamanalab|yioopbot|youda|zeus|zmeu|zune|zyborg) [NC]

        RewriteRule .* - [F]

# RewriteRule .* /nG_log.php?log [END,NE,E=nG_USER_AGENT:%1]

</IfModule>
# 8G:[REMOTE HOST]
<IfModule mod_rewrite.c>

        RewriteCond %{REMOTE_HOST} (163data|amazonaws|colocrossing|crimea|g00g1e|justhost|kanagawa|loopia|masterhost|onlinehome|poneytel|sprintdatacenter|reverse.softlayer|safenet|ttnet|woodpecker|wowrack) [NC]

        RewriteRule .* - [F]

# RewriteRule .* /nG_log.php?log [END,NE,E=nG_REMOTE_HOST:%1]

</IfModule>
# 8G:[HTTP REFERRER]
<IfModule mod_rewrite.c>

        RewriteCond %{HTTP_REFERER} (order(\s|%20)by(\s|%20)1--) [NC,OR]
        RewriteCond %{HTTP_REFERER} (@unlink|assert\(|print_r\(|x00|xbshell) [NC,OR]
        RewriteCond %{HTTP_REFERER} (100dollars|best-seo|blue\spill|cocaine|ejaculat|erectile|erections|hoodia|huronriveracres|impotence|levitra|libido|lipitor|mopub\.com|phentermin) [NC,OR]
        RewriteCond %{HTTP_REFERER} (pornhelm|pro[sz]ac|sandyauer|semalt\.com|social-buttions|todaperfeita|tramadol|troyhamby|ultram|unicauca|valium|viagra|vicodin|xanax|ypxaieo) [NC]

        RewriteRule .* - [F]

# RewriteRule .* /nG_log.php?log [END,NE,E=nG_HTTP_REFERRER:%1]

</IfModule>
# 8G:[HTTP COOKIE]
<IfModule mod_rewrite.c>

        RewriteCond %{HTTP_COOKIE} (<|>|\'|%0A|%0D|%27|%3C|%3E|%00) [NC]

        RewriteRule .* - [F]

# RewriteRule .* /nG_log.php?log [END,NE,E=nG_HTTP_COOKIE:%1]

</IfModule>

# 8G:[REQUEST METHOD]
<IfModule mod_rewrite.c>

        RewriteCond %{REQUEST_METHOD} ^(connect|debug|move|trace|track) [NC]

        RewriteRule .* - [F]

# RewriteRule .* /nG_log.php?log [END,NE,E=nG_REQUEST_METHOD:%1]

</IfModule>


# mod_deflate compression
<IfModule mod_deflate.c>
    SetOutputFilter DEFLATE

    <IfModule mod_setenvif.c>
        <IfModule mod_headers.c>
            SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
            RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
        </IfModule>
    </IfModule>

    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE "application/atom+xml" \
                                      "application/javascript" \
                                      "application/json" \
                                      "application/ld+json" \
                                      "application/manifest+json" \
                                      "application/rdf+xml" \
                                      "application/rss+xml" \
                                      "application/schema+json" \
                                      "application/vnd.geo+json" \
                                      "application/vnd.ms-fontobject" \
                                      "application/x-font-ttf" \
                                      "application/x-font-opentype" \
                                      "application/x-font-truetype" \
                                      "application/x-javascript" \
                                      "application/x-web-app-manifest+json" \
                                      "application/xhtml+xml" \
                                      "application/xml" \
                                      "font/eot" \
                                      "font/opentype" \
                                      "font/otf" \
                                      "image/bmp" \
                                      "image/svg+xml" \
                                      "image/vnd.microsoft.icon" \
                                      "image/x-icon" \
                                      "text/cache-manifest" \
                                      "text/css" \
                                      "text/html" \
                                      "text/javascript" \
                                      "text/plain" \
                                      "text/vcard" \
                                      "text/vnd.rim.location.xloc" \
                                      "text/vtt" \
                                      "text/x-component" \
                                      "text/x-cross-domain-policy" \
                                      "text/xml"
    </IfModule>

    <IfModule mod_mime.c>
        AddEncoding gzip svgz
    </IfModule>
</IfModule>

# Dynamically serves Brotli/gzip if precompressed files exist.
# Fallbacks to mod_deflate for other content.
# Maintains browser and proxy compatibility via Vary.
<IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteBase /
        
        <FilesMatch "\.(js|css|xml|svg|wasm)$">
            RewriteCond %{HTTP:Accept-encoding} br
            RewriteCond %{REQUEST_FILENAME}.br -f
            RewriteRule ^(.*)$ $1.br [T=application/x-brotli,E=no-gzip:1,L]

            RewriteCond %{HTTP:Accept-encoding} gzip
            RewriteCond %{REQUEST_FILENAME}.gz -f
            RewriteRule ^(.*)$ $1.gz [T=application/x-gzip,E=no-brotli:1,L]
        </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
        <FilesMatch "\.(js\.br|css\.br|xml\.br|svg\.br|wasm\.br)$">
            Header append Content-Encoding br
        </FilesMatch>

        <FilesMatch "\.(js\.gz|css\.gz|xml\.gz|svg\.gz|wasm\.gz)$">
            Header append Content-Encoding gzip
        </FilesMatch>

        Header append Vary Accept-Encoding
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Preserve Authorization Header
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    RewriteBase /
    RewriteRule ^index\.php$ - [L]
    
    # add a trailing slash to /wp-admin
    RewriteRule ^wp-admin$ wp-admin/ [R=301,L]
    
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^(wp-(content|admin|includes).*) $1 [L]
    RewriteRule ^(.*\.php)$ $1 [L]
    RewriteRule . index.php [L]
</IfModule>
# END WordPress

# Security Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
   
    # Block Malicious Image Uploads with Embedded PHP
    RewriteCond %{HTTP:Content-Disposition} \.php [NC]
    RewriteCond %{HTTP:Content-Type} ^image/ [NC]
    RewriteRule .* - [F,L]
</IfModule>

# Image Rewrites
# Ensure manual WebP/AVIF delivery
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Check for AVIF browser support, but ONLY for JPG, GIF, SVG (no PNG)
  RewriteCond %{HTTP:Accept} image/avif
  RewriteCond %{DOCUMENT_ROOT}/$1.avif -f
  RewriteRule (.+)\.(jpe?g|gif|svg)$ $1.avif [T=image/avif,E=image_optimized:1,L]

  # Check for WebP browser support, but ONLY for JPG, GIF, SVG (no PNG)
  RewriteCond %{HTTP:Accept} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule (.+)\.(jpe?g|gif|svg)$ $1.webp [T=image/webp,E=image_optimized:1,L]

  # Fallback to original image
  RewriteCond %{ENV:image_optimized} !1
  RewriteRule (.+)\.(jpe?g|png|gif|svg)$ $1.$2 [L]
  
</IfModule>

# Ensure the Vary Header is set for proper caching
    <FilesMatch "\.(jpe?g|svg|webp|gif|avif)$">
        <IfModule mod_headers.c>
          Header append Vary Accept env=image_optimized
        </IfModule>
   </FilesMatch>


# Headers
<IfModule mod_headers.c>
    Header set Content-Language "en-US"

    # remove server information for security protection
    Header unset Server

    # force UTF-8
    Header set Content-Type "text/html; charset=UTF-8"
    Header set Content-Type "application/xhtml+xml; charset=UTF-8"
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Content-Type "text/xml; charset=UTF-8"
    Header set Content-Type "application/atom+xml; charset=UTF-8"
    Header set Content-Type "application/rss+xml; charset=UTF-8"
    Header set Content-Type "application/json; charset=UTF-8"
    Header set Content-Type "text/plain; charset=UTF-8"
    
    # Force the latest IE version, in various cases when it may fall back to IE7 mode
    # futher details: github.com/rails/rails/commit/123eb25#commitcomment-118920
    # Use ChromeFrame if it's installed for a better experience for the poor IE folks
    Header set X-UA-Compatible "IE=Edge,chrome=1"
    # mod_headers cannnot match by content-type, but we don't want to send this header on *everything*...
    <FilesMatch "\.(js|css|gif|png|jpe?g|pdf|xml|oga|ogg|m4a|ogv|mp4|m4v|webm|svg|svgz|eot|ttf|otf|woff|ico|webp|appcache|manifest|htc|crx|oex|xpi|safariextz|vcf)$" >
        Header unset X-UA-Compatible
    </FilesMatch>
    #Header set P3P "policyref="/w3c/p3p.xml", CP="NOI DSP COR NID CUR ADM DEV OUR BUS""
    # OR THIS, SIMPLER
    # Header set P3P "policyref="/w3c/p3p.xml""

    # Content Security policy and Feature Policy
    #Header always set Content-Security-Policy "default-src 'self'"
    # OR
    #Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
     # Content Security Policy (CSP) – Adjust as needed
    #Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'self';"
    
    Header set Feature-Policy "camera '*'; fullscreen '*'; geolocation *; microphone '*'; autoplay *"
</IfModule>

# CORS Headers
<IfModule mod_setenvif.c>
    # Capture the Origin header dynamically
    SetEnvIf Origin "^https?://(.*)$" OriginHeader=$0
</IfModule>

<IfModule mod_headers.c>
    # Apply Access-Control-Allow-Origin dynamically based on Origin header
    Header always set Access-Control-Allow-Origin "%{OriginHeader}e" env=OriginHeader

    # Restrict CORS to only images (Prevents hotlinking abuse)
    <FilesMatch "\.(bmp|cur|gif|ico|jpe?g|a?png|svgz?|webp|heic|heif|avif)$">
        SetEnvIf Origin ":" IS_CORS
        Header set Access-Control-Allow-Origin "*" env=IS_CORS
        Header set Vary "Origin" env=IS_CORS
    </FilesMatch>
</IfModule>

## Pre-check Handling Options for the CORS
<IfModule mod_rewrite.c>
    # Handle CORS Preflight Requests (OPTIONS method) only for non-existing files/directories
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# Allow timing metrics for performance measurement
<IfModule mod_setenvif.c>
    # Capture the Origin header dynamically for Timing-Allow-Origin
    SetEnvIf Origin "^https?://(.*)$" TimingOrigin=$0
</IfModule>

<IfModule mod_headers.c>
    Header always set Timing-Allow-Origin "%{TimingOrigin}e" env=TimingOrigin
</IfModule>

# CORS for Fonts
<IfModule mod_setenvif.c>
    SetEnvIf Origin "^https?://(.*)$" DynamicOrigin=$0
</IfModule>

<IfModule mod_headers.c>
    # Apply dynamic CORS policy to fonts & images
    <FilesMatch "\.(bmp|cur|gif|ico|jpe?g|a?png|svgz?|webp|heic|heif|avif|eot|otf|ttf|ttc|woff|woff2)$">
        Header always set Access-Control-Allow-Origin "%{DynamicOrigin}e" env=DynamicOrigin
        Header set Vary "Origin"
    </FilesMatch>
</IfModule>

# Specify the CORS Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Methods "GET, PUT, POST, OPTIONS, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Custom-Header, DNT, Keep-Alive, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Upgrade-Insecure-Requests"
    Header always set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Max-Age "1728000"

    # Enforce HTTPS (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    #Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Expect-CT "max-age=86400, enforce"

    # Secure Cookies
    Header always edit Set-Cookie "(.*)" "$1; Secure; HttpOnly; SameSite=Lax"

    # Improved Referrer Policy (avoid info leaks)
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Enforce Certificate Transparency (CT)
    Header always set Expect-CT "max-age=86400, enforce"

    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Disable XSS Protection (Modern browsers handle it natively)
    Header always set X-XSS-Protection "0"
</IfModule>

## FORCE ONESIGNAL UTF-8

<Files OneSignalSDKWorker.js.php>
    Allow from all
    ForceType 'application/javascript; charset=UTF-8'
</Files>

<Files OneSignalSDKWorker.js>
    Allow from all
    ForceType 'application/javascript; charset=UTF-8'
</Files>

## WP Defender - Prevent information disclosure ##

<FilesMatch "\.(png|jpe?g|gif|webp|svg)$">
  Require all granted
</FilesMatch>

# Block specific file types from direct access
<FilesMatch "\.(env|ini|pl|py|jsp|asp|cgi)$">
    Require all denied
</FilesMatch>

# Block wp-config.php, .htaccess, .htpasswd, and debug.log
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|debug\.log)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|exe|sh|bak|old|inc|pot|po|mo|log|sql|htaccess|htpasswd|phps|fla|psd|ini|conf|pool|jail|env|d|conf)$">
Order allow,deny
Deny from all
</FilesMatch>

<Files robots.txt>
Allow from all
</Files>

<Files security.txt>
Allow from all
</Files>

<Files ads.txt>
Allow from all
</Files>

<Files sitemap.xml>
Allow from all
</Files>

## WP Defender - End ##

# BEGIN WP-HUMMINGBIRD-CACHING
# The directives (lines) between "BEGIN WP-HUMMINGBIRD-CACHING" and "END WP-HUMMINGBIRD-CACHING" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.

## END WP-HUMMINGBIRD-CACHING

# Browser Cache methods
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault A0

    # Images
    <FilesMatch "\.(gif|png|apng|jpe?g|webp|avif|svgz?|ico|bmp)$">
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/apng "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/avif "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType image/svgz "access plus 1 year"
        ExpiresByType image/x-icon "access plus 1 year"
        ExpiresByType image/bmp "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Fonts
    <FilesMatch "\.(ttf|otf|woff2?|eot)$">
        ExpiresByType font/ttf "access plus 1 year"
        ExpiresByType font/otf "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType application/font-woff "access plus 1 year"
        ExpiresByType application/font-woff2 "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Videos & Audio
    <FilesMatch "\.(mp4|mp3|ogg|wav|flac|m4a|webm|weba)$">
        ExpiresByType video/mp4 "access plus 1 day"
        ExpiresByType audio/mp3 "access plus 1 day"
        ExpiresByType audio/ogg "access plus 1 day"
        ExpiresByType audio/wav "access plus 1 day"
        ExpiresByType audio/flac "access plus 1 day"
        ExpiresByType audio/m4a "access plus 1 day"
        ExpiresByType video/webm "access plus 1 year"
        ExpiresByType audio/weba "access plus 1 year"
        Header set Cache-Control "public, max-age=86400, must-revalidate, stale-if-error=86400"
    </FilesMatch>

    # CSS, JS
    <FilesMatch "\.(css|js)$">
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType text/javascript "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType application/x-javascript "access plus 1 year"
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # feeds
    <FilesMatch "\.(atom|rss)$">
        ExpiresByType application/atom+xml "access plus 1 hour"
        ExpiresByType application/rss+xml "access plus 1 hour"
        Header set Cache-Control "public, max-age=3600, must-revalidate, stale-if-error=3600"
    </FilesMatch>

    # GZIP, BROTLI
    <FilesMatch "\.(br|gz)$">
      ExpiresByType application/x-brotli "access plus 1 hour"
      ExpiresByType application/x-gzip "access plus 1 hour"
      Header set Cache-Control "max-age=3600, public"
    </FilesMatch>

    # files
    <FilesMatch "\.pdf$">
        ExpiresByType application/pdf "access plus 1 year"
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

   #JSON, TEXT
   <FilesMatch "\.(json|txt)$">
        ExpiresByType application/json "access plus 1 year"
        ExpiresByType text/plain "access plus 1 year"
        Header set Cache-Control "max-age=31536000"
    </FilesMatch>

    # Static Configuration Files (manifest.json, browserconfig.xml)
    <FilesMatch "\.(json)$">
      ExpiresActive On
      ExpiresByType application/json "access plus 1 year"
      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=31536000, immutable, stale-if-error=86400"
      </IfModule>
    </FilesMatch>

    <FilesMatch "\.(xml)$">
      ExpiresActive On
      ExpiresByType application/xml "access plus 1 year"
      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=31536000, immutable, stale-if-error=86400"
      </IfModule>
    </FilesMatch>

   # RSS/Atom Feeds (feed, atom.xml) - Adjust filename matching if needed
    <FilesMatch "(feed|atom\.xml)$">
      ExpiresActive On
      ExpiresByType application/rss+xml "access plus 1 hour"
      ExpiresByType application/atom+xml "access plus 1 hour"
      <IfModule mod_headers.c>
          Header set Cache-Control "public, max-age=3600, must-revalidate, stale-if-error=3600"
      </IfModule>
   </FilesMatch>

    # API Responses (/wp-json/*) - These should NOT be cached
    <FilesMatch "^/wp-json/.*$">
      ExpiresActive Off
      <IfModule mod_headers.c>
          Header set Cache-Control "no-store, must-revalidate, private"
          Header set Expires "0"
      </IfModule>
    </FilesMatch>

    <FilesMatch "\.(html|htm|php)$">
        ExpiresActive Off
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
